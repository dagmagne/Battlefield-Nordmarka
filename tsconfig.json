  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "skipLibCheck": true,
    "strict": false
  },
  "include": ["src/**/*.js", "src/types.d.ts"],
  "exclude": ["src/sw.js"]
}
